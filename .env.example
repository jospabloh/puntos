# Puntos+ environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Variables prefixed with VITE_ are exposed to the client-side bundle.

# Base44 platform configuration
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=

# Admin notification recipient (REQUIRED to enable admin alerts).
# Used client-side in Onboarding (new-merchant alerts). There is no
# hardcoded fallback in source — if this is unset, the admin notification
# is skipped silently and onboarding still succeeds.
VITE_ADMIN_NOTIFICATION_EMAIL=

# Admin notification recipient for server-side scheduled functions
# (e.g. checkTrialExpiration). Configured in the Base44 function
# environment, not the Vite build. Mirrors VITE_ADMIN_NOTIFICATION_EMAIL.
# If unset, server-side admin notifications and the support-contact line
# in trial emails are skipped (the trial lifecycle logic still runs).
# ADMIN_NOTIFICATION_EMAIL=

# ── Wallet passes (Base44 function environment, not the Vite build) ──────────
# Google Wallet (balance push in updateWalletPasses):
# GOOGLE_WALLET_SERVICE_ACCOUNT=   # full service-account JSON
# GOOGLE_WALLET_ISSUER_ID=

# Apple Wallet pass signing (createAppleWalletPass / passkitWebService):
# APPLE_WALLET_TEAM_ID=
# APPLE_WALLET_PASS_TYPE_ID=
# APPLE_WALLET_CERT_P12_BASE64=
# APPLE_WALLET_CERT_PASSWORD=

# Apple Wallet update service (optional — enables registration + auto-refresh):
# APPLE_WALLET_WEB_SERVICE_URL=    # public invoke URL of the passkitWebService function;
#                                  # when set, issued passes advertise it (webServiceURL)
# APPLE_WALLET_AUTH_SECRET=        # HMAC secret for the pass authenticationToken
#                                  # (falls back to APPLE_WALLET_CERT_PASSWORD if unset)
# Apple APNs token-based push (optional — enables automatic balance push):
# APPLE_APNS_KEY_P8=               # contents of the .p8 APNs auth key (PKCS8 PEM)
# APPLE_APNS_KEY_ID=               # the key's 10-char Key ID
