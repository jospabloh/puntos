{
  "name": "Redemption",
  "type": "object",
  "description": "Record of a customer redeeming an offer. Created server-side by redeemOffer. Tenant- and store-scoped for staff/admins.",
  "properties": {
    "account_id": { "type": "string", "description": "ID de la cuenta de loyalty" },
    "user_id": { "type": "string", "description": "ID del usuario" },
    "user_email": { "type": "string", "description": "Email del usuario" },
    "business_id": { "type": "string", "description": "ID del negocio (tenant)" },
    "business_name": { "type": "string", "description": "Nombre del negocio (denormalizado)" },
    "offer_id": { "type": "string", "description": "ID de la oferta canjeada" },
    "offer_title": { "type": "string", "description": "Título de la oferta (denormalizado)" },
    "store_id": { "type": "string", "description": "Tienda donde se canjeó" },
    "store_name": { "type": "string", "description": "Nombre de la tienda" },
    "points_spent": { "type": "number", "description": "Puntos gastados" },
    "value_mxn": { "type": "number", "description": "Valor en pesos" },
    "status": { "type": "string", "enum": ["pending", "confirmed", "used", "expired", "cancelled"], "default": "pending" },
    "confirmation_code": { "type": "string", "description": "Código de confirmación" },
    "ledger_id": { "type": "string", "description": "ID del movimiento en el ledger" },
    "expires_at": { "type": "string", "format": "date-time", "description": "Cuándo expira el canje" },
    "used_at": { "type": "string", "format": "date-time", "description": "Cuándo se usó" },
    "operator_id": { "type": "string", "description": "Cajero que confirmó el uso" },
    "metadata": { "type": "object" }
  },
  "required": ["account_id", "user_id", "offer_id", "points_spent"],
  "rls": {
    "create": { "$or": [ { "user_condition": { "role": "admin" } }, { "data.user_id": "{{user.id}}" } ] },
    "read": { "$or": [ { "user_condition": { "role": "admin" } }, { "data.user_id": "{{user.id}}" }, { "$and": [ { "user_condition": { "role": "merchant" } }, { "data.store_id": "{{user.data.storeId}}" } ] }, { "$and": [ { "user_condition": { "role": "merchant" } }, { "data.business_id": "{{user.data.business_id}}" } ] }, { "$and": [ { "user_condition": { "role": "business_admin" } }, { "data.business_id": "{{user.data.business_id}}" } ] } ] },
    "update": { "$or": [ { "user_condition": { "role": "admin" } }, { "$and": [ { "user_condition": { "role": "merchant" } }, { "data.store_id": "{{user.data.storeId}}" } ] }, { "$and": [ { "user_condition": { "role": "merchant" } }, { "data.business_id": "{{user.data.business_id}}" } ] }, { "$and": [ { "user_condition": { "role": "business_admin" } }, { "data.business_id": "{{user.data.business_id}}" } ] } ] },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
