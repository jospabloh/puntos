{
  "name": "PointsLedger",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "ID de la cuenta de loyalty"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario (denormalizado para queries)"
    },
    "business_id": {
      "type": "string",
      "description": "ID del negocio (tenant)"
    },
    "business_name": {
      "type": "string",
      "description": "Nombre del negocio (denormalizado)"
    },
    "store_id": {
      "type": "string",
      "description": "ID de la tienda donde ocurri\u00f3"
    },
    "store_name": {
      "type": "string",
      "description": "Nombre de tienda (denormalizado)"
    },
    "type": {
      "type": "string",
      "enum": [
        "EARN",
        "BURN",
        "ADJUST",
        "EXPIRE",
        "REVERSAL",
        "BONUS"
      ],
      "description": "Tipo de movimiento"
    },
    "points": {
      "type": "number",
      "description": "Cantidad de puntos (positivo=suma, negativo=resta)"
    },
    "balance_after": {
      "type": "number",
      "description": "Saldo despu\u00e9s de esta transacci\u00f3n"
    },
    "amount": {
      "type": "number",
      "description": "Monto de la compra en MXN (si aplica)"
    },
    "currency": {
      "type": "string",
      "default": "MXN",
      "description": "Moneda de la transacci\u00f3n"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "purchase",
        "redemption",
        "campaign",
        "manual",
        "expiration",
        "reversal"
      ],
      "description": "Tipo de referencia"
    },
    "reference_id": {
      "type": "string",
      "description": "ID de la entidad relacionada"
    },
    "ticket_id": {
      "type": "string",
      "description": "ID del ticket/recibo de compra"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Clave \u00fanica para evitar duplicados"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del movimiento"
    },
    "reason": {
      "type": "string",
      "description": "Raz\u00f3n (obligatoria para ADJUST)"
    },
    "campaign_id": {
      "type": "string",
      "description": "ID de campa\u00f1a si aplica multiplicador"
    },
    "multiplier": {
      "type": "number",
      "default": 1,
      "description": "Multiplicador aplicado"
    },
    "operator_id": {
      "type": "string",
      "description": "ID del cajero/admin que proces\u00f3"
    },
    "operator_email": {
      "type": "string",
      "description": "Email del operador"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "reversed",
        "flagged"
      ],
      "default": "completed",
      "description": "Estado del movimiento"
    },
    "risk_score": {
      "type": "number",
      "description": "Score de riesgo de fraude (0-100)"
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Banderas de riesgo detectadas"
    },
    "metadata": {
      "type": "object",
      "description": "Datos adicionales"
    }
  },
  "required": [
    "account_id",
    "user_id",
    "type",
    "points",
    "idempotency_key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            },
            {
              "data.store_id": "{{user.data.storeId}}"
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "data.store_id": "{{user.data.storeId}}"
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}