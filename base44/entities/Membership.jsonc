{
  "description": "Modulo 18 (jospabloh/acacia-app-standard -> STANDARD.md): una fila por (business_id, user_id) al que este usuario pertenece. User.business_id/role siguen siendo el puntero al negocio ACTIVO -- esta entidad es el registro de a cuales pertenece, para poder ofrecer un selector y volver a uno anterior sin perderlo.",
  "name": "Membership",
  "properties": {
    "business_id": {
      "description": "Negocio al que da acceso esta membresia.",
      "type": "string"
    },
    "business_name": {
      "description": "Nombre del negocio al momento de crear la membresia -- solo informativo, para no depender de una lectura de Business que RLS podria negar si el negocio no esta activo.",
      "type": "string"
    },
    "user_id": {
      "description": "Id (Base44) del usuario dueno de esta membresia.",
      "type": "string"
    },
    "user_email": {
      "description": "Correo del usuario al momento de crear la membresia -- solo informativo, nunca se usa para autorizar.",
      "type": "string"
    },
    "role": {
      "description": "Rol que este usuario tiene EN ESTE negocio -- se re-deriva al cambiar de negocio activo, nunca se copia del rol que el usuario tenia en otro negocio.",
      "enum": ["business_admin", "merchant"],
      "type": "string"
    },
    "store_id": {
      "description": "Para role=merchant: la tienda asignada dentro de este negocio.",
      "type": "string"
    },
    "store_name": {
      "type": "string"
    }
  },
  "required": ["business_id", "user_id", "role"],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}
