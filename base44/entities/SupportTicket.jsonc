{
  "name": "SupportTicket",
  "type": "object",
  "description": "Support ticket raised by a tenant to the platform owner.",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "billing",
        "technical",
        "account",
        "feature_request",
        "pos",
        "loyalty",
        "other"
      ],
      "default": "other"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting_customer",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "created_by_id": {
      "type": "string"
    },
    "created_by_email": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "first_response_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_by_role": {
      "type": "string",
      "enum": [
        "owner",
        "tenant"
      ]
    },
    "messages_count": {
      "type": "number",
      "default": 0
    },
    "unread_for_owner": {
      "type": "boolean",
      "default": true
    },
    "unread_for_tenant": {
      "type": "boolean",
      "default": false
    },
    "satisfaction_rating": {
      "type": "number"
    },
    "metadata": {
      "type": "object"
    },
    "ai_brief": {
      "type": "object",
      "description": "Especificación estructurada que arma el asistente BA/PO al levantar un feature (feature_request) o una incidencia técnica (historia de usuario, criterios de aceptación, pasos de reproducción, severidad, impacto, etc.). El mismo brief se incrusta en 'description' en Markdown, así que este campo es aditivo para el render enriquecido en la consola del owner."
    }
  },
  "required": [
    "business_id",
    "subject"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}