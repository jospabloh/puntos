{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID del usuario"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario"
    },
    "business_id": {
      "type": "string",
      "description": "ID del negocio (tenant)"
    },
    "campaigns_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Recibir notificaciones de nuevas campa\u00f1as"
    },
    "offers_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Recibir notificaciones de nuevas ofertas"
    },
    "points_activity_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Notificaciones de movimientos de puntos"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Recibir notificaciones por email"
    }
  },
  "required": [
    "user_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}