{
  "name": "LicenseEvent",
  "type": "object",
  "description": "Audit trail of license/billing changes for a tenant.",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "trial_started",
        "trial_extended",
        "plan_changed",
        "license_activated",
        "license_renewed",
        "license_expired",
        "view_only",
        "suspended",
        "reactivated",
        "archived"
      ]
    },
    "from_plan": {
      "type": "string"
    },
    "to_plan": {
      "type": "string"
    },
    "from_status": {
      "type": "string"
    },
    "to_status": {
      "type": "string"
    },
    "amount_mxn": {
      "type": "number"
    },
    "payment_reference": {
      "type": "string"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "event_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}