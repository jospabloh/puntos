{
  "name": "SupportTicketMessage",
  "type": "object",
  "description": "A single message in a SupportTicket thread. Internal notes (is_internal_note=true) are visible only to the platform owner — enforced both via RLS and the UI.",
  "properties": {
    "ticket_id": { "type": "string", "description": "ID del ticket al que pertenece" },
    "business_id": { "type": "string", "description": "ID del negocio (denormalizado para RLS)" },
    "author_id": { "type": "string", "description": "ID del autor del mensaje" },
    "author_email": { "type": "string", "description": "Email del autor" },
    "author_name": { "type": "string", "description": "Nombre del autor" },
    "author_role": { "type": "string", "enum": ["owner", "tenant"], "description": "Rol del autor en el contexto del ticket" },
    "body": { "type": "string", "description": "Contenido del mensaje" },
    "is_internal_note": { "type": "boolean", "default": false, "description": "Nota interna visible solo para el soporte (owner)" },
    "attachments": { "type": "array", "items": { "type": "string" }, "description": "URLs de archivos adjuntos" }
  },
  "required": ["ticket_id", "business_id", "body"],
  "rls": {
    "create": {
      "$or": [
        { "$and": [ { "user_condition": { "role": "business_admin" } }, { "data.business_id": "{{user.data.business_id}}" }, { "data.is_internal_note": false } ] },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "$and": [ { "user_condition": { "role": "business_admin" } }, { "data.business_id": "{{user.data.business_id}}" }, { "data.is_internal_note": false } ] },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}
