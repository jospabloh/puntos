{
  // User — the Base44 auth user, extended with platform/tenant fields.
  //
  // SECURITY: the privileged fields below (role, tenant, store assignment) carry
  // FIELD-LEVEL write RLS locking them to role `admin` — which is the tier the
  // service role evaluates as. End users therefore CANNOT set their own role or
  // business via auth.updateMe (that path let any user escalate to
  // business_admin/admin). All legitimate changes flow through service-role
  // functions: createBusiness, createLoyaltyAccount, acceptInvitation (onboarding)
  // and manageTeamMember (tenant team management). Self-service fields below
  // (phone, onboarding_completed, last_active_at) stay user-writable.
  //
  // DEPLOY ORDER: deploy those functions FIRST, then this schema. If the lock
  // lands before the functions set roles server-side, new onboarding/team changes
  // silently no-op (Base44 drops disallowed field writes) and users get stuck.
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "business_admin",
        "merchant",
        "customer",
        "user"
      ],
      "description": "Rol de plataforma: admin (dueño ACACIA), business_admin (admin del negocio), merchant (equipo/cajero), customer (cliente). 'user' es heredado y se trata como customer. BLOQUEO DE ESCRITURA (solo role:admin, es decir servicio/dueño de plataforma). Gobierna la ESCRITURA, no la lectura. Si se abre, cualquier usuario se auto-escala llamando a base44.auth.updateMe({...}) desde el navegador: ese es exactamente el agujero que este bloqueo cierra, y ninguna regla de RLS de otra entidad puede taparlo, porque todas confían en estos campos. Sin él, cualquiera se hace 'admin' y con eso entra por la rama de servicio de TODAS las reglas de RLS del portafolio.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "app_role": {
      "type": "string",
      "enum": [
        "owner",
        "business_admin",
        "staff",
        "customer"
      ],
      "description": "Rol de aplicación (espejo legible del rol). BLOQUEO DE ESCRITURA (solo role:admin, es decir servicio/dueño de plataforma). Gobierna la ESCRITURA, no la lectura. Si se abre, cualquier usuario se auto-escala llamando a base44.auth.updateMe({...}) desde el navegador: ese es exactamente el agujero que este bloqueo cierra, y ninguna regla de RLS de otra entidad puede taparlo, porque todas confían en estos campos. Se mueve siempre junto a 'role'; dejarlo abierto deja los dos espejos en desacuerdo.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "business_id": {
      "type": "string",
      "description": "ID del negocio (inquilino) al que pertenece el usuario. Es el puntero de inquilino: todas las reglas de RLS de este repo comparan contra {{user.data.business_id}}. BLOQUEO DE ESCRITURA (solo role:admin, es decir servicio/dueño de plataforma). Gobierna la ESCRITURA, no la lectura. Si se abre, cualquier usuario se auto-escala llamando a base44.auth.updateMe({...}) desde el navegador: ese es exactamente el agujero que este bloqueo cierra, y ninguna regla de RLS de otra entidad puede taparlo, porque todas confían en estos campos. Sin él, un usuario apunta su cuenta al inquilino que quiera y lee sus datos — la misma clase de fallo que FlowFin sufrió en User.family_id (módulo 19).",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "business_name": {
      "type": "string",
      "description": "Nombre del negocio (denormalizado). BLOQUEO DE ESCRITURA (solo role:admin, es decir servicio/dueño de plataforma). Gobierna la ESCRITURA, no la lectura. Si se abre, cualquier usuario se auto-escala llamando a base44.auth.updateMe({...}) desde el navegador: ese es exactamente el agujero que este bloqueo cierra, y ninguna regla de RLS de otra entidad puede taparlo, porque todas confían en estos campos. Va con business_id; abierto por su cuenta, deja el nombre mintiendo sobre el inquilino real.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "storeId": {
      "type": "string",
      "description": "ID de la tienda asignada al cajero — camelCase a propósito: es el nombre que leen las reglas de RLS ({{user.data.storeId}}). BLOQUEO DE ESCRITURA (solo role:admin, es decir servicio/dueño de plataforma). Gobierna la ESCRITURA, no la lectura. Si se abre, cualquier usuario se auto-escala llamando a base44.auth.updateMe({...}) desde el navegador: ese es exactamente el agujero que este bloqueo cierra, y ninguna regla de RLS de otra entidad puede taparlo, porque todas confían en estos campos. Sin él, un cajero se reasigna a otra tienda y ve sus cuentas y su caja.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "store_id": {
      "type": "string",
      "description": "ID de la tienda asignada (alias snake_case de storeId, conservado por ramas heredadas de RLS). BLOQUEO DE ESCRITURA (solo role:admin, es decir servicio/dueño de plataforma). Gobierna la ESCRITURA, no la lectura. Si se abre, cualquier usuario se auto-escala llamando a base44.auth.updateMe({...}) desde el navegador: ese es exactamente el agujero que este bloqueo cierra, y ninguna regla de RLS de otra entidad puede taparlo, porque todas confían en estos campos. Mismo riesgo que storeId; los dos se bloquean o no se bloquea ninguno.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "store_name": {
      "type": "string",
      "description": "Nombre de la tienda asignada (denormalizado). BLOQUEO DE ESCRITURA (solo role:admin, es decir servicio/dueño de plataforma). Gobierna la ESCRITURA, no la lectura. Si se abre, cualquier usuario se auto-escala llamando a base44.auth.updateMe({...}) desde el navegador: ese es exactamente el agujero que este bloqueo cierra, y ninguna regla de RLS de otra entidad puede taparlo, porque todas confían en estos campos. Va con storeId.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "merchant_role": {
      "type": "string",
      "description": "Marca heredada de cajero ('merchant'), aún leída por ramas antiguas de RLS y por deleteMyAccount. BLOQUEO DE ESCRITURA (solo role:admin, es decir servicio/dueño de plataforma). Gobierna la ESCRITURA, no la lectura. Si se abre, cualquier usuario se auto-escala llamando a base44.auth.updateMe({...}) desde el navegador: ese es exactamente el agujero que este bloqueo cierra, y ninguna regla de RLS de otra entidad puede taparlo, porque todas confían en estos campos. Sin él, un cliente se marca como cajero y entra por esas ramas heredadas.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "phone": {
      "type": "string",
      "description": "Teléfono de contacto"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Si el usuario completó el onboarding"
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "Última actividad significativa"
    }
  },
  "required": []
}
