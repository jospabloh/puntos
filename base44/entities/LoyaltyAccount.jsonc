{
  "name": "LoyaltyAccount",
  "type": "object",
  "properties": {
    "current_balance": {
      "default": 0,
      "description": "Saldo actual de puntos (cache, fuente de verdad es el ledger)",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "number"
    },
    "last_activity": {
      "description": "\u00daltima actividad en el programa",
      "format": "date-time",
      "type": "string"
    },
    "lifetime_earned": {
      "default": 0,
      "description": "Total de puntos ganados hist\u00f3ricamente",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "number"
    },
    "lifetime_redeemed": {
      "default": 0,
      "description": "Total de puntos canjeados hist\u00f3ricamente",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "number"
    },
    "metadata": {
      "description": "Datos adicionales flexibles",
      "type": "object"
    },
    "onboarding_completed": {
      "default": false,
      "description": "Si ya complet\u00f3 el proceso de onboarding",
      "type": "boolean"
    },
    "phone": {
      "description": "Tel\u00e9fono opcional",
      "type": "string"
    },
    "qr_token": {
      "description": "Token único del QR del cliente; el POS busca la cuenta por él (MerchantPOS.jsx). BLOQUEO DE ESCRITURA — módulo 14 del estándar ACACIA, hallazgo cerrado en la v2.0.15 (2026-08-24). Gobierna la ESCRITURA, no la lectura: quitarlo no cambia lo que devuelve una consulta. rls.write:false porque el token lo generan createLoyaltyAccount, regenerateExpiredQR y refreshQrToken (función de servicio acotada a la cuenta propia del llamante), nunca el navegador. Sin el bloqueo, un cliente se pone como token el de otro cliente de su misma tienda y cobra sus puntos. OJO: Wallet.jsx escribía este campo directo cada 5 minutos; esa escritura se reemplazó por refreshQrToken — si vuelves a abrir el bloqueo por un fallo de refresco del QR, el error está en refreshQrToken, no aquí.",
      "rls": {
        "write": false
      },
      "type": "string"
    },
    "qr_token_expires": {
      "description": "Expiraci\u00f3n del token QR",
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "active",
      "description": "Estado de la cuenta",
      "enum": [
        "active",
        "suspended",
        "closed"
      ],
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "store_code": {
      "description": "C\u00f3digo de la tienda (denormalizado)",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "store_id": {
      "description": "ID de la tienda a la que pertenece la cuenta (solo clientes). BLOQUEO DE ESCRITURA — módulo 14 del estándar ACACIA, hallazgo cerrado en la v2.0.15 (2026-08-24). Gobierna la ESCRITURA, no la lectura: quitarlo no cambia lo que devuelve una consulta. Misma razón que business_id: la regla de entidad valida el registro almacenado, así que sin el $and a nivel de campo un cajero mueve una cuenta a una tienda de otro inquilino. earnPoints/burnPoints comparan este campo contra la tienda que cobra.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "merchant"
                  }
                },
                {
                  "data.business_id": "{{user.data.business_id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "business_admin"
                  }
                },
                {
                  "data.business_id": "{{user.data.business_id}}"
                }
              ]
            }
          ]
        }
      },
      "type": "string"
    },
    "store_name": {
      "description": "Nombre de la tienda (denormalizado)",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "business_id": {
      "description": "ID del negocio (inquilino) dueño del programa al que pertenece esta cuenta. BLOQUEO DE ESCRITURA — módulo 14 del estándar ACACIA, hallazgo cerrado en la v2.0.15 (2026-08-24). Gobierna la ESCRITURA, no la lectura: quitarlo no cambia lo que devuelve una consulta. La regla de campo repite el $and de data.business_id == {{user.data.business_id}} que la regla de entidad ya aplica, porque la de entidad se evalúa sobre el registro ALMACENADO: sin el $and a nivel de campo, un cajero pasa el filtro por su propia tienda y entonces escribe aquí un negocio ajeno, empujando una cuenta propia fuera de su inquilino.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "merchant"
                  }
                },
                {
                  "data.business_id": "{{user.data.business_id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "business_admin"
                  }
                },
                {
                  "data.business_id": "{{user.data.business_id}}"
                }
              ]
            }
          ]
        }
      },
      "type": "string"
    },
    "business_name": {
      "description": "Nombre del negocio (denormalizado)",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "subscription_plan": {
      "default": "trial",
      "description": "Plan de suscripci\u00f3n actual",
      "enum": [
        "trial",
        "monthly",
        "annual"
      ],
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "subscription_status": {
      "default": "trial",
      "description": "Estado de la suscripci\u00f3n",
      "enum": [
        "trial",
        "active",
        "inactive",
        "canceled"
      ],
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "tier": {
      "default": "bronze",
      "description": "Nivel de membres\u00eda",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "trial_end_date": {
      "description": "Fecha de fin de la prueba gratuita (30 d\u00edas)",
      "format": "date-time",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "trial_start_date": {
      "description": "Fecha de inicio de la prueba gratuita",
      "format": "date-time",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "user_email": {
      "description": "Email del usuario para b\u00fasqueda r\u00e1pida",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "user_id": {
      "description": "ID del usuario propietario",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      },
      "type": "string"
    },
    "user_name": {
      "description": "Nombre del cliente",
      "type": "string"
    },
    "welcome_message_shown": {
      "default": false,
      "description": "Si ya se mostr\u00f3 el mensaje de bienvenida del trial",
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "data.store_id": "{{user.data.storeId}}"
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "merchant"
              }
            },
            {
              "data.store_id": "{{user.data.storeId}}"
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        }
      ]
    }
  }
}