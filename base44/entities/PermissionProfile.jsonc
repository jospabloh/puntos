{
  "description": "Per-tenant override of the default capability matrix.",
  "name": "PermissionProfile",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "permissions": {
      "additionalProperties": true,
      "type": "object"
    },
    "role_key": {
      "enum": [
        "business_admin",
        "staff",
        "customer"
      ],
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "role_key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.business_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}