{
  "name": "WalletRegistration",
  "type": "object",
  "description": "Apple Wallet (PassKit) device registration. Written only by the passkitWebService function (service role) when a device adds/removes a pass; used by updateWalletPasses to APNs-push balance updates. Never touched by end users.",
  "properties": {
    "device_library_id": { "type": "string", "description": "Apple deviceLibraryIdentifier" },
    "pass_type_id": { "type": "string", "description": "passTypeIdentifier" },
    "serial_number": { "type": "string", "description": "Pass serial (the LoyaltyAccount id)" },
    "push_token": { "type": "string", "description": "APNs push token for this device" },
    "account_id": { "type": "string", "description": "LoyaltyAccount id" },
    "user_id": { "type": "string", "description": "Owner user id" },
    "business_id": { "type": "string", "description": "Tenant id (denormalized)" },
    "last_updated_tag": { "type": "string", "description": "Opaque update tag returned to Apple (passesUpdatedSince)" },
    "active": { "type": "boolean", "default": true, "description": "False once the device unregisters" }
  },
  "required": ["device_library_id", "pass_type_id", "serial_number"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
