{
  "description": "Apple Wallet (PassKit) device registration. Written only by the passkitWebService function (service role).",
  "name": "WalletRegistration",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "active": {
      "default": true,
      "type": "boolean"
    },
    "business_id": {
      "type": "string"
    },
    "device_library_id": {
      "type": "string"
    },
    "last_updated_tag": {
      "type": "string"
    },
    "pass_type_id": {
      "type": "string"
    },
    "push_token": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "device_library_id",
    "pass_type_id",
    "serial_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}