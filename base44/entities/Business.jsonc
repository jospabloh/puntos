{
  "description": "Tenant. A business that runs its own Puntos+ loyalty program.",
  "name": "Business",
  "properties": {
    "activated_by_admin": {
      "type": "string"
    },
    "activation_notes": {
      "type": "string"
    },
    "address": {
      "description": "Direcci\u00f3n",
      "type": "string"
    },
    "archived_at": {
      "format": "date-time",
      "type": "string"
    },
    "auto_renewal": {
      "default": false,
      "type": "boolean"
    },
    "billing_status": {
      "default": "trial",
      "enum": [
        "trial",
        "active",
        "view_only",
        "suspended",
        "archived"
      ],
      "type": "string"
    },
    "city": {
      "description": "Ciudad",
      "type": "string"
    },
    "contact_email": {
      "description": "Email de contacto principal",
      "type": "string"
    },
    "industry": {
      "description": "Giro / industria",
      "type": "string"
    },
    "invite_code": {
      "description": "C\u00f3digo para que el equipo se una",
      "type": "string"
    },
    "invite_code_active": {
      "default": true,
      "type": "boolean"
    },
    "legal_name": {
      "description": "Raz\u00f3n social",
      "type": "string"
    },
    "license_activated_at": {
      "format": "date-time",
      "type": "string"
    },
    "license_cycle": {
      "default": "monthly",
      "enum": [
        "monthly",
        "annual"
      ],
      "type": "string"
    },
    "license_expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "license_plan": {
      "default": "starter",
      "enum": [
        "starter",
        "growth",
        "pro",
        "enterprise"
      ],
      "type": "string"
    },
    "licensed_store_limit": {
      "default": 1,
      "type": "number"
    },
    "licensed_user_limit": {
      "default": 2,
      "type": "number"
    },
    "logo_url": {
      "description": "URL del logotipo",
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "name": {
      "description": "Nombre comercial del negocio",
      "type": "string"
    },
    "owner_email": {
      "description": "Email del due\u00f1o",
      "type": "string"
    },
    "owner_user_id": {
      "description": "ID del usuario due\u00f1o",
      "type": "string"
    },
    "payment_reference": {
      "type": "string"
    },
    "phone": {
      "description": "Tel\u00e9fono",
      "type": "string"
    },
    "primary_color": {
      "default": "#7c3aed",
      "description": "Color de marca primario",
      "type": "string"
    },
    "rfc": {
      "description": "RFC fiscal",
      "type": "string"
    },
    "scheduled_delete_at": {
      "format": "date-time",
      "type": "string"
    },
    "state": {
      "description": "Estado",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "suspended"
      ],
      "type": "string"
    },
    "support_contacted_at": {
      "format": "date-time",
      "type": "string"
    },
    "trial_end_at": {
      "format": "date-time",
      "type": "string"
    },
    "trial_start_at": {
      "format": "date-time",
      "type": "string"
    },
    "view_only_since": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}