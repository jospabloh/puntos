    "view_only_since": {
      "description": "Desde cu\u00e1ndo el inquilino est\u00e1 en solo-lectura por falta de pago. BLOQUEO DE ESCRITURA (rls.write:false) \u2014 m\u00f3dulo 1 del est\u00e1ndar ACACIA, reforzado el 2026-08-21. Lo escribe SOLO Mission Control, por servicio (cron de licencias o la funci\u00f3n licensesAdmin), nunca el cliente. Gobierna la ESCRITURA, no la lectura: quitarlo no cambia ni un byte de lo que devuelve una consulta \u2014 lo \u00fanico que habilita es que el business_admin del propio inquilino, que ya tiene update sobre su fila de Business, se edite su propia licencia. Sin \u00e9l, un inquilino borra la marca de su propia degradaci\u00f3n.",
      "format": "date-time",
      "rls": {
        "write": false
      },
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "data.tenant_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}