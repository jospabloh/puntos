    },
    "scheduled_delete_at": {
      "description": "Fecha en que Mission Control borrará al inquilino tras su baja. BLOQUEO DE ESCRITURA (rls.write:false) — módulo 1 del estándar ACACIA, reforzado el 2026-08-21. Lo escribe SOLO Mission Control, por servicio (cron de licencias o la función licensesAdmin), nunca el cliente. Gobierna la ESCRITURA, no la lectura: quitarlo no cambia ni un byte de lo que devuelve una consulta — lo único que habilita es que el business_admin del propio inquilino, que ya tiene update sobre su fila de Business, se edite su propia licencia. Sin él, un inquilino cancela su propio borrado programado.",
      "format": "date-time",
      "type": "string",
      "rls": { "write": false }
    },
    "state": {
      "description": "Estado",
      "type": "string"
    },
    "status": {
      "description": "Estado operativo del inquilino (active/suspended); se lee junto a billing_status en canTenantWrite(). BLOQUEO DE ESCRITURA (rls.write:false) — módulo 1 del estándar ACACIA, reforzado el 2026-08-21. Lo escribe SOLO Mission Control, por servicio (cron de licencias o la función licensesAdmin), nunca el cliente. Gobierna la ESCRITURA, no la lectura: quitarlo no cambia ni un byte de lo que devuelve una consulta — lo único que habilita es que el business_admin del propio inquilino, que ya tiene update sobre su fila de Business, se edite su propia licencia. Sin él, un inquilino suspendido se reactiva por esta segunda vía aunque billing_status siga bloqueado.",
      "default": "active",
      "enum": [
        "active",
        "suspended"
      ],
      "type": "string",
      "rls": { "write": false }
    },
    "support_contacted_at": {
      "format": "date-time",
      "type": "string"
    },
    "trial_end_at": {
      "description": "Fin del periodo de prueba de 30 días, fijado al crear el inquilino. BLOQUEO DE ESCRITURA (rls.write:false) — módulo 1 del estándar ACACIA, reforzado el 2026-08-21. Lo escribe SOLO Mission Control, por servicio (cron de licencias o la función licensesAdmin), nunca el cliente. Gobierna la ESCRITURA, no la lectura: quitarlo no cambia ni un byte de lo que devuelve una consulta — lo único que habilita es que el business_admin del propio inquilino, que ya tiene update sobre su fila de Business, se edite su propia licencia. Sin él, la prueba es infinita: el inquilino empuja la fecha cada vez que se acerca.",
      "format": "date-time",
      "type": "string",
      "rls": { "write": false }
    },
    "trial_start_at": {
      "description": "Inicio del periodo de prueba, fijado al crear el inquilino. BLOQUEO DE ESCRITURA (rls.write:false) — módulo 1 del estándar ACACIA, reforzado el 2026-08-21. Lo escribe SOLO Mission Control, por servicio (cron de licencias o la función licensesAdmin), nunca el cliente. Gobierna la ESCRITURA, no la lectura: quitarlo no cambia ni un byte de lo que devuelve una consulta — lo único que habilita es que el business_admin del propio inquilino, que ya tiene update sobre su fila de Business, se edite su propia licencia. Sin él, un inquilino reinicia su prueba moviendo esta fecha.",
      "format": "date-time",
      "type": "string",
      "rls": { "write": false }
    },
    "view_only_since": {
      "description": "Desde cuándo el inquilino está en solo-lectura por falta de pago. BLOQUEO DE ESCRITURA (rls.write:false) — módulo 1 del estándar ACACIA, reforzado el 2026-08-21. Lo escribe SOLO Mission Control, por servicio (cron de licencias o la función licensesAdmin), nunca el cliente. Gobierna la ESCRITURA, no la lectura: quitarlo no cambia ni un byte de lo que devuelve una consulta — lo único que habilita es que el business_admin del propio inquilino, que ya tiene update sobre su fila de Business, se edite su propia licencia. Sin él, un inquilino borra la marca de su propia degradación.",
      "format": "date-time",
      "type": "string",
      "rls": { "write": false }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "business_admin"
              }
            },
            {
              "id": "{{user.data.business_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}